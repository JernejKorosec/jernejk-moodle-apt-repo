# Copy to mysql_setup_moodle_db.env and edit.
# Do not commit the .env file with real secrets.

# Moodle DB settings
DB_NAME="moodle"
DB_USER="moodleuser"

# Sensitive values - set your real values locally
DB_PASS="CHANGE_ME_STRONG_PASSWORD"
MYSQL_ROOT_PASS="CHANGE_ME_ROOT_PASSWORD"

# Optional: if MYSQL_ROOT_PASS is empty, script will try this file in same directory
ROOT_PASS_FILE="mysql_root.txt"
