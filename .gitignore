prompts.md

# Local docker build secrets/config
docker/docker-script/00_config.env

# Do not track numbered scripts folders (versioning is done by git tags)
scripts/[0-9]*/

# Never commit real env secrets; keep examples
scripts/**/*.env
!scripts/**/*.env.example

# Never commit GPG private key material
gpg/*
!gpg/.gitkeep
private.key
private.asc
secret.key
secret.asc
